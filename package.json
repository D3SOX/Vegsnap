{
  "name": "vegsnap",
  "version": "0.2.11",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "extension"
  ],
  "scripts": {
    "test": "bun test packages scripts && bun run --filter @vegsnap/extension test",
    "test:package": "bun run --filter @vegsnap/extension test:package",
    "typecheck": "bun run --filter '*' typecheck",
    "check:companion": "cargo test --manifest-path companion/Cargo.toml",
    "check:android": "cd android && ./gradlew testDebugUnitTest lintDebug",
    "data:offline": "bun scripts/offline-snapshot.ts",
    "screenshots": "python3 scripts/screenshots.py capture",
    "screenshots:apply": "python3 scripts/screenshots.py apply",
    "test:screenshots": "python3 -m unittest discover -s scripts/screenshots -p \"test_*.py\" && bun x tsc -p scripts/screenshots/tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "1.63.0",
    "typescript": "^5.9.3"
  }
}
