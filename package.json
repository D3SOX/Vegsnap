{
  "name": "vegsnap",
  "version": "0.2.19",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "extension"
  ],
  "scripts": {
    "test": "bun test packages scripts && bun run --filter @vegsnap/extension test",
    "test:package": "bun run --filter @vegsnap/extension test:package",
    "typecheck": "bun run --filter '*' typecheck && tsc -p scripts/tsconfig.json",
    "lint": "biome lint --error-on-warnings .",
    "check:companion": "cargo test --manifest-path companion/Cargo.toml",
    "check:android": "cd android && ./gradlew detekt testDebugUnitTest lintDebug",
    "data:offline": "bun scripts/offline-snapshot.ts",
    "screenshots": "python3 scripts/screenshots.py capture",
    "screenshots:apply": "python3 scripts/screenshots.py apply",
    "test:screenshots": "python3 -m unittest discover -s scripts/screenshots -p \"test_*.py\" && bun x tsc -p scripts/screenshots/tsconfig.json",
    "ios:prepare": "bun ios/prepare.ts",
    "test:ios-bridge": "bun test ios/Bridge",
    "check:ios-types": "bun x tsc --noEmit --target ES2022 --module ESNext --moduleResolution bundler --resolveJsonModule --allowSyntheticDefaultImports --lib ES2022,DOM --types bun ios/Bridge/entry.ts ios/Bridge/bridge.test.ts ios/prepare.ts",
    "schema:generate": "bun scripts/ai-schema.ts",
    "strings:generate": "bun scripts/localization.ts",
    "strings:check": "bun scripts/localization.ts --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.4.3",
    "playwright": "1.64.1",
    "typescript": "^7.0.2"
  }
}
