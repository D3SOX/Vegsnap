require "json"
require "fileutils"
require "tmpdir"

default_platform(:android)

platform :android do
  desc "Verify API access to Vegsnap's Alpha track"
  lane :verify_play do
    validate_play_store_json_key(json_key: ENV.fetch("PLAY_JSON_KEY"))
    google_play_track_version_codes(
      package_name: "app.vegsnap",
      track: "alpha",
      json_key: ENV.fetch("PLAY_JSON_KEY")
    )
  end

  desc "Submit a signed release bundle and localized notes to Google Play Alpha"
  lane :publish_play do |options|
    root = File.expand_path("..", __dir__)
    listing = JSON.parse(File.read(File.expand_path(options[:listing] || "android/play/listing.json", root)))
    UI.user_error!("Expected the existing app.vegsnap package") unless listing.fetch("package_name") == "app.vegsnap"
    bundle = File.expand_path(options.fetch(:aab), root)
    UI.user_error!("App Bundle not found: #{bundle}") unless File.file?(bundle)

    Dir.mktmpdir("vegsnap-play-notes") do |metadata|
      listing.fetch("locales").each do |locale, text|
        notes = text.fetch("release_notes")
        UI.user_error!("#{locale} release notes must contain 1–500 characters") unless (1..500).cover?(notes.length)
        directory = File.join(metadata, locale, "changelogs")
        FileUtils.mkdir_p(directory)
        File.write(File.join(directory, "default.txt"), notes)
      end
      upload_to_play_store(
        package_name: "app.vegsnap",
        track: "alpha",
        release_status: "completed",
        aab: bundle,
        json_key: ENV.fetch("PLAY_JSON_KEY"),
        metadata_path: metadata,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        validate_only: options[:validate_only] == true,
        changes_not_sent_for_review: false,
        rescue_changes_not_sent_for_review: false
      )
    end
  end
end
