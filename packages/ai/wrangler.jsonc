{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vegsnap-ai",
  "account_id": "cf8bbc47f2bc101e87d665bda1438b49",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "triggers": { "crons": ["15 * * * *"] },
  "observability": { "enabled": false },
  "vars": {
    "PUBLIC_ORIGIN": "https://vegsnap-ai.withered-flower-f0f2.workers.dev",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFRbioeIjAuuTkl1",
    "AI_ENABLED": "true",
    "DAILY_CHECK_LIMIT": "100",
    "SESSION_CHECK_LIMIT": "3",
    "DAILY_CONNECT_LIMIT": "100",
    "PENDING_CONNECT_LIMIT": "100"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "vegsnap-ai", "database_id": "1bd35d5d-a8f9-4375-a4c2-f8634154d910", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "REQUEST_LIMIT", "namespace_id": "826402", "simple": { "limit": 5, "period": 60 } },
    { "name": "SESSION_REQUEST_LIMIT", "namespace_id": "826403", "simple": { "limit": 30, "period": 60 } }
  ]
}
