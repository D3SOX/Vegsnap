{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "types": ["bun"], "lib": ["ES2022", "DOM"],
    "noUncheckedIndexedAccess": true, "skipLibCheck": true
  },
  "include": ["src", "test"]
}
