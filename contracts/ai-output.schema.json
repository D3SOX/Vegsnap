{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string"
    },
    "complete": {
      "type": "boolean"
    },
    "category": {
      "type": "string",
      "enum": [
        "food",
        "drink",
        "cosmetics",
        "household",
        "clothing",
        "shoes",
        "other"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "brand": {
      "type": [
        "string",
        "null"
      ]
    },
    "barcode": {
      "type": [
        "string",
        "null"
      ]
    },
    "ingredientAssessments": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "term": {
            "type": "string"
          },
          "status": {
            "enum": [
              "plant",
              "animal",
              "ambiguous",
              "unknown"
            ],
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "translatedTerm": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "term",
          "status",
          "explanation",
          "translatedTerm"
        ]
      }
    },
    "labelObservations": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "vegan_certification",
              "vegan_claim"
            ],
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name",
          "text"
        ]
      }
    },
    "webClaims": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "claim": {
            "enum": [
              "vegan",
              "not_vegan"
            ],
            "type": "string"
          },
          "sourceType": {
            "enum": [
              "manufacturer",
              "certification"
            ],
            "type": "string"
          },
          "productName": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "quote",
          "claim",
          "sourceType",
          "productName",
          "brand"
        ]
      }
    },
    "contact": {
      "anyOf": [
        {
          "$ref": "#/$defs/manufacturerContact"
        },
        {
          "type": "null"
        }
      ]
    },
    "webCompositions": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "complete": {
            "type": "boolean"
          },
          "sourceType": {
            "enum": [
              "manufacturer",
              "retailer"
            ],
            "type": "string"
          },
          "productName": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "ingredients": {
            "anyOf": [
              {
                "$ref": "#/$defs/ingredients"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "url",
          "text",
          "complete",
          "sourceType",
          "productName",
          "brand",
          "ingredients"
        ]
      }
    },
    "companyAssessment": {
      "anyOf": [
        {
          "$ref": "#/$defs/companyAssessment"
        },
        {
          "type": "null"
        }
      ]
    },
    "ingredients": {
      "anyOf": [
        {
          "$ref": "#/$defs/ingredients"
        },
        {
          "type": "null"
        }
      ]
    },
    "packaging": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "variant": {
          "type": [
            "string",
            "null"
          ]
        },
        "quantity": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "language",
        "country",
        "variant",
        "quantity"
      ]
    },
    "alternatives": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "store": {
            "type": [
              "string",
              "null"
            ]
          },
          "storeUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "storeQuote": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "brand",
          "url",
          "quote",
          "store",
          "storeUrl",
          "storeQuote"
        ]
      }
    }
  },
  "required": [
    "text",
    "complete",
    "category",
    "name",
    "brand",
    "barcode",
    "ingredientAssessments",
    "labelObservations",
    "webClaims",
    "contact",
    "webCompositions",
    "companyAssessment",
    "ingredients",
    "packaging",
    "alternatives"
  ],
  "$defs": {
    "manufacturerContact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceUrl": {
          "type": "string"
        },
        "productName": {
          "type": "string"
        },
        "brand": {
          "type": "string"
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "sourceUrl",
        "productName",
        "brand",
        "email",
        "url"
      ]
    },
    "companyAssessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brand": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "direct",
            "parent"
          ],
          "type": "string"
        },
        "verdict": {
          "enum": [
            "concerns_found",
            "no_concerns_found",
            "inconclusive"
          ],
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "categories": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "enum": [
              "animal_testing",
              "animal_welfare_lobbying",
              "animal_exploitation"
            ],
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "quote": {
                "type": "string"
              }
            },
            "required": [
              "url",
              "title",
              "quote"
            ]
          }
        },
        "ownershipSourceUrl": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "brand",
        "company",
        "scope",
        "verdict",
        "summary",
        "categories",
        "sources",
        "ownershipSourceUrl"
      ]
    },
    "ingredients": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string"
      }
    }
  }
}
