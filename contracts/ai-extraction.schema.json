{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "maxLength": 20000
    },
    "complete": {
      "type": "boolean"
    },
    "category": {
      "type": "string",
      "enum": [
        "food",
        "drink",
        "cosmetics",
        "household",
        "clothing",
        "shoes",
        "other"
      ]
    },
    "name": {
      "type": "string",
      "maxLength": 300
    },
    "brand": {
      "type": "string",
      "maxLength": 300
    },
    "barcode": {
      "type": "string",
      "pattern": "^(?:[0-9]{8}|[0-9]{12}|[0-9]{13}|[0-9]{14})$"
    },
    "ingredientAssessments": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "status": {
            "enum": [
              "plant",
              "animal",
              "ambiguous",
              "unknown"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "translatedTerm": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "term",
          "status",
          "explanation"
        ]
      }
    },
    "labelObservations": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "vegan_certification",
              "vegan_claim"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "kind",
          "name",
          "text"
        ]
      }
    },
    "webClaims": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2000
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "claim": {
            "enum": [
              "vegan",
              "not_vegan"
            ]
          },
          "sourceType": {
            "enum": [
              "manufacturer",
              "certification"
            ]
          },
          "productName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "brand": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "url",
          "quote",
          "claim",
          "sourceType",
          "productName",
          "brand"
        ]
      }
    },
    "contact": {
      "$ref": "#/$defs/manufacturerContact"
    },
    "webCompositions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2000
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "complete": {
            "type": "boolean"
          },
          "sourceType": {
            "enum": [
              "manufacturer",
              "retailer"
            ]
          },
          "productName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "brand": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "url",
          "text",
          "complete",
          "sourceType",
          "productName",
          "brand"
        ]
      }
    },
    "companyAssessment": {
      "$ref": "#/$defs/companyAssessment"
    }
  },
  "required": [
    "text",
    "complete",
    "category"
  ],
  "$defs": {
    "manufacturerContact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2000
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "brand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2000
        }
      },
      "required": [
        "sourceUrl",
        "productName",
        "brand"
      ],
      "anyOf": [
        {
          "required": [
            "email"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ]
    },
    "companyAssessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "company": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "scope": {
          "enum": [
            "direct",
            "parent"
          ]
        },
        "verdict": {
          "enum": [
            "concerns_found",
            "no_concerns_found",
            "inconclusive"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "categories": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "animal_testing",
              "animal_welfare_lobbying",
              "animal_exploitation"
            ]
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "format": "uri",
                "pattern": "^https://"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "url",
              "title",
              "quote"
            ]
          }
        },
        "ownershipSourceUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "format": "uri",
          "pattern": "^https://"
        }
      },
      "required": [
        "brand",
        "company",
        "scope",
        "verdict",
        "summary",
        "categories",
        "sources"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "parent"
              }
            }
          },
          "then": {
            "required": [
              "ownershipSourceUrl"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "concerns_found"
              }
            }
          },
          "then": {
            "properties": {
              "categories": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "no_concerns_found"
              }
            }
          },
          "then": {
            "properties": {
              "categories": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
