{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "result.schema.json"
      }
    }
  },
  "required": [
    "schemaVersion",
    "exportedAt",
    "results"
  ]
}
