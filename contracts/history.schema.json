{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vegsnap.invalid/schemas/history.schema.json",
  "title": "Vegsnap history export",
  "description": "A history transfer carries public analyses only: no photos, drafts, credentials or community overlays. Clients accept at most 1,000 results and 5 MB.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "results": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "result.schema.json"
      }
    }
  },
  "required": [
    "schemaVersion",
    "exportedAt",
    "results"
  ]
}
